#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-restart}" in
  restart|start)
    exec "$SCRIPT_DIR/restart.sh"
    ;;
  stop|kill)
    exec "$SCRIPT_DIR/kill.sh"
    ;;
  settings)
    exec "$SCRIPT_DIR/open-settings.sh"
    ;;
  *)
    echo "Usage: taskbar [restart|start|stop|kill|settings]" >&2
    exit 2
    ;;
esac
