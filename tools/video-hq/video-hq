#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${VIDEO_HQ_APP_DIR:-$HOME/Applications/Video HQ.app}"

case "${1:-open}" in
  open|start)
    if [[ ! -d "$APP_DIR" ]]; then
      exec bash "$SCRIPT_DIR/setup_mac.sh"
    fi
    open "$APP_DIR"
    ;;
  install|build)
    exec bash "$SCRIPT_DIR/setup_mac.sh"
    ;;
  *)
    echo "Usage: video-hq [open|start|install|build]" >&2
    exit 2
    ;;
esac
