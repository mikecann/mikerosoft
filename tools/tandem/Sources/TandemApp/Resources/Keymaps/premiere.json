{
  "name": "Premiere",
  "bindings": {
    "space": "playPause",
    "j": "shuttleReverse",
    "k": "shuttleStop",
    "l": "shuttleForward",
    "left": "stepBack",
    "right": "stepForward",
    "shift+left": "stepBackFive",
    "shift+right": "stepForwardFive",
    "home": "goToStart",
    "end": "goToEnd",
    "up": "previousEdit",
    "down": "nextEdit",
    "shift+m": "nextMarker",
    "cmd+shift+m": "previousMarker",

    "i": "markIn",
    "o": "markOut",
    "option+i": "clearIn",
    "option+o": "clearOut",
    "option+x": "clearInOut",
    "x": "markClip",
    ";": "liftInOut",
    "'": "extractInOut",

    "cmd+b": "bladeAtPlayhead",
    "cmd+k": "bladeAtPlayhead",
    "q": "rippleTrimStart",
    "w": "rippleTrimEnd",
    "option+k": "toggleKeyframe",
    "shift+j": "previousKeyframe",
    "shift+k": "nextKeyframe",
    "cmd+option+v": "addVideoTrack",
    "cmd+option+a": "addAudioTrack",
    "delete": "lift",
    "forwarddelete": "lift",
    "shift+delete": "rippleDelete",
    "option+delete": "rippleDelete",
    ",": "nudgeLeft",
    ".": "nudgeRight",
    "shift+,": "nudgeLeftFive",
    "shift+.": "nudgeRightFive",
    "option+left": "nudgeLeft",
    "option+right": "nudgeRight",
    "cmd+l": "link",
    "m": "addMarker",
    "cmd+d": "addTransition",
    "1": "layoutFull",
    "2": "layoutPipRight",
    "3": "layoutPipLeft",
    "4": "layoutSplit",

    "cmd+a": "selectAll",
    "cmd+shift+a": "deselectAll",
    "escape": "deselectAll",
    "a": "selectForward",

    "=": "zoomIn",
    "-": "zoomOut",
    "cmd+=": "zoomIn",
    "cmd+-": "zoomOut",
    "shift+z": "zoomToFit",
    "\\": "zoomToFit",
    "s": "toggleSnapping",
    "cmd+shift+l": "toggleLinkedSelection",
    "shift+r": "toggleRipple",
    "t": "toggleTranscriptLane",

    "v": "toolSelect",
    "c": "toolBlade",
    "b": "toolRippleTrim",
    "n": "toolRoll",
    "y": "toolSlip",
    "u": "toolSlide",

    "cmd+'": "toggleSafeMargins",
    "cmd+shift+p": "toggleProxy",

    "cmd+z": "undo",
    "cmd+shift+z": "redo",
    "cmd+s": "save",
    "cmd+shift+s": "saveVersion",
    "cmd+e": "export",
    "cmd+n": "newProject",
    "cmd+o": "openProject"
  }
}
